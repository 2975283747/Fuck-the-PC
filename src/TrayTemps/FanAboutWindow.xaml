<Window x:Class="TrayTemps.FanAboutWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrayTemps"
        Title="关于 Fuck the PC"
        Width="540"
        Height="410"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#F5F5F7" />
        <SolidColorBrush x:Key="TitleBarBackground" Color="#FBFBFD" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#1D1D1F" />
        <SolidColorBrush x:Key="TextSecondary" Color="#6E6E73" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DEDEE3" />
        <SolidColorBrush x:Key="DividerBrush" Color="#E3E3E8" />
        <SolidColorBrush x:Key="Accent" Color="#0071E3" />
        <Style x:Key="LinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="TextDecorations" Value="None" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="18"
            Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            TextElement.Foreground="{DynamicResource TextPrimary}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="6"
                              Opacity="0.2"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackground}"
                    CornerRadius="18,18,0,0"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Margin="22,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <Button x:Name="CloseButton"
                            Content="✕"
                            Width="34"
                            Height="28"
                            Margin="0,0,14,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextSecondary}"
                            Cursor="Hand"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="28,22,28,24">
                <StackPanel Orientation="Horizontal">
                    <local:FanIcon Width="64"
                                   Height="64"
                                   IsActive="False"
                                   IsSpinning="False" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText"
                                   Text="Fuck the PC"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="SubtitleText"
                                   Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,20,0,0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="ThanksTitleText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="ThanksBodyText"
                                   Margin="0,9,0,0"
                                   FontSize="12"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <StackPanel Margin="0,13,0,0">
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                <Hyperlink Style="{StaticResource LinkStyle}"
                                           NavigateUri="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor"
                                           RequestNavigate="Link_RequestNavigate">
                                    LibreHardwareMonitor / Libre
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                <Hyperlink Style="{StaticResource LinkStyle}"
                                           NavigateUri="https://github.com/namazso/PawnIO"
                                           RequestNavigate="Link_RequestNavigate">
                                    PawnIO
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="VersionText"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

